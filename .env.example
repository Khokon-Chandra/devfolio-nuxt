# ── Contact form (server-side only) ──────────────────────────────────────
# Create a key at https://resend.com → API Keys, then add these three in
# Vercel → Project → Settings → Environment Variables (and locally in .env).
#
# Without NUXT_RESEND_API_KEY the form still renders and validates, but
# submitting returns 503 and the UI falls back to a prefilled mailto link.

NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_CONTACT_TO=khokonchandra4@gmail.com

# 'onboarding@resend.dev' needs no domain verification, but Resend will only
# deliver from it to the address that owns the API key. Swap in your own
# verified domain (e.g. "Portfolio <hello@khokon.dev>") when you have one.
NUXT_CONTACT_FROM=Portfolio <onboarding@resend.dev>
